# Completa todos los valores en App Service Configuration o un .env local no versionado.
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Azure SQL; el servidor no arranca si quedan placeholders.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD=your-password

# PIN inicial individual de 4 dígitos. Cambiar cada placeholder por un valor distinto.
# Usa estos nombres exactos en App Service Application settings.
USER_PIN_PAMELA_PEREZ=change-me
USER_PIN_NATANIEL_GOYECHEA=change-me
USER_PIN_DAVID_MAGLIONE=change-me
USER_PIN_ALEN_GARCIA=change-me
USER_PIN_ROBERTO_MARTIN=change-me
USER_PIN_DIEC_SAS=change-me

# SMTP autenticado (STARTTLS normalmente usa el puerto 587).
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-sender
